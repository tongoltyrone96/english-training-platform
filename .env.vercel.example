DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
AUTH_TRUST_HOST="true"
AUTH_SECURE_COOKIES="true"
AUTH_URL="https://YOUR-PROJECT.vercel.app"
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_INVITATION_CODE="replace-with-a-private-code-of-at-least-8-characters"
APP_TIME_ZONE="Europe/London"
GROQ_API_KEY="replace-with-your-groq-api-key"
GROQ_WHISPER_MODEL="whisper-large-v3-turbo"
GROQ_LANGUAGE_MODEL="openai/gpt-oss-20b"
EVALUATION_MODE="real"
# Created automatically when a Private Vercel Blob store is connected.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
